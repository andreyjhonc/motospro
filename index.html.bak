<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#0B1120">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Motos@Motos">
  
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏍️</text></svg>">
  
  <title>Motos@Motos - Gestor de Rutas</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  
  
  <link rel="manifest" href="manifest.json">












  <link rel="stylesheet" href="styles.css">
  <meta name="theme-color" content="#0B1120">
</head>
<body data-theme="pesopro" class="text-slate-100 flex flex-col min-h-screen select-none">

  <div class="app-shell w-full max-w-md mx-auto min-h-screen bg-[#070A12] flex flex-col relative border-x border-[#1C263E] shadow-2xl">
    
    <!-- HEADER -->
    <header class="px-4 py-3 bg-[#070A12]/90 backdrop-blur-md border-b border-[#1C263E] flex items-center justify-between sticky top-0 z-30">
      <div class="flex items-center space-x-2">
        <span class="text-xl">🏍️</span>
        <span class="font-black text-lg text-[#00E676] tracking-wide">Motos@Motos</span>
      </div>
      <div class="flex items-center space-x-2">
        <button onclick="openStatsModal()" class="p-2 rounded-xl bg-[#0E1526] border border-[#1C263E] text-[#00E676] active:scale-95 transition-all hover:border-[#00E676]/50" title="Informes y Arqueo">
          📊
        </button>
        <div id="status-indicator" class="w-2.5 h-2.5 rounded-full bg-slate-600 transition-colors"></div>
      </div>
    </header>

    <!-- NAVBAR SUPERIOR -->
    
    <!-- TOP NAV PREMIUM + LEFT SIDEBAR -->
    

    <!-- Desktop Sidebar -->
    <div class="desktop-sidebar hidden">
      <div style="width:48px; height:48px; border-radius:14px; background:var(--theme-primary); display:flex; align-items:center; justify-content:center; font-weight:900; color:black; font-size:18px; margin-bottom:12px; box-shadow:0 0 20px rgba(255,106,0,0.4)">M</div>
      <button onclick="switchTab('inicio')" id="d-nav-inicio" class="side-btn active"><span style="font-size:20px">🏠</span><span>INICIO</span></button>
      <button onclick="switchTab('rutas')" id="d-nav-rutas" class="side-btn"><span style="font-size:20px">🗺️</span><span>RUTAS</span></button>
      <button onclick="switchTab('nueva')" id="d-nav-nueva" class="side-btn"><span style="font-size:20px">📷</span><span>AÑADIR</span></button>
      <button onclick="switchTab('buscar')" id="d-nav-buscar" class="side-btn"><span style="font-size:20px">🔍</span><span>BUSCAR</span></button>
      <button onclick="switchTab('peritaje')" id="d-nav-peritaje" class="side-btn"><span style="font-size:20px">🛡️</span><span>PERITAJE</span></button>
      <div style="flex:1"></div>
      <button onclick="switchTab('ajustes')" id="d-nav-ajustes" class="side-btn"><span style="font-size:20px">⚙️</span><span>AJUSTES</span></button>
      <div style="width:40px; height:40px; border-radius:50%; background:linear-gradient(135deg,#333,#111); border:1px solid var(--theme-border); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; margin-top:8px;">AC</div>
    </div>

    <!-- NUEVO BOTTOM DOCK - ISLA CENTRADA MISMA ALTURA -->
    <nav class="bottom-dock" id="bottom-dock">
      <button onclick="switchTab('inicio')" id="nav-inicio" class="dock-btn active" data-tab="inicio">
        <span class="dock-icon">🏠</span>
        <span class="dock-label">INICIO</span>
      </button>
      <button onclick="switchTab('rutas')" id="nav-rutas" class="dock-btn" data-tab="rutas">
        <span class="dock-icon">🗺️</span>
        <span class="dock-label">RUTAS</span>
      </button>
      <button onclick="switchTab('nueva')" id="nav-nueva" class="dock-btn add" data-tab="nueva">
        <span class="dock-icon">📷</span>
        <span class="dock-label">AÑADIR</span>
      </button>
      <button onclick="switchTab('buscar')" id="nav-buscar" class="dock-btn" data-tab="buscar">
        <span class="dock-icon">🔍</span>
        <span class="dock-label">BUSCAR</span>
      </button>
      <button onclick="switchTab('ajustes')" id="nav-ajustes" class="dock-btn" data-tab="ajustes">
        <span class="dock-icon">⚙️</span>
        <span class="dock-label">AJUSTES</span>
      </button>
    </nav>
    <!-- Submenu chips contextual FUNCIONAL -->
    <div id="submenu-rutas" class="submenu-chips hidden">
      <button class="chip active" id="chip-activas" onclick="handleRutasSubmenu('activas')">Activas</button>
      <button class="chip" id="chip-historico" onclick="handleRutasSubmenu('historico')">Histórico</button>
      <button class="chip" id="chip-arqueo" onclick="handleRutasSubmenu('arqueo')">Arqueo</button>
      <button class="chip" id="chip-peritaje" onclick="handleRutasSubmenu('peritaje')">🛡️ Peritaje</button>
    </div>



    <!-- NOTIFICACIONES TOAST -->
    <div id="toast" class="fixed top-28 left-1/2 -translate-x-1/2 bg-[#FF007F] text-white px-4 py-2.5 rounded-full font-black text-xs shadow-2xl z-50 flex items-center space-x-2 transition-all duration-300 opacity-0 pointer-events-none max-w-[90%] text-center glow-pink">
      <span id="toast-text">Mensaje</span>
    </div>

    <!-- INPUTS OCULTOS -->
    <input type="file" id="albaran-camera-input" accept="image/*" capture="environment" class="hidden" onchange="processCapture(event, 'albaran')" style="display:none!important;position:absolute;width:0;height:0;opacity:0;pointer-events:none">
    <input type="file" id="albaran-gallery-input" accept="image/*" class="hidden" onchange="processCapture(event, 'albaran')" style="display:none!important;position:absolute;width:0;height:0;opacity:0;pointer-events:none">
    <input type="file" id="inspection-camera-input" accept="image/*" capture="environment" class="hidden" onchange="processCapture(event, 'inspection')" style="display:none!important;position:absolute;width:0;height:0;opacity:0;pointer-events:none">
    <input type="file" id="inspection-gallery-input" accept="image/*" class="hidden" onchange="processCapture(event, 'inspection')" style="display:none!important;position:absolute;width:0;height:0;opacity:0;pointer-events:none">
    <input type="file" id="restore-backup-input" accept=".json" class="hidden" onchange="handleRestoreBackup(event)" style="display:none!important;position:absolute;width:0;height:0;opacity:0;pointer-events:none">
    <input type="file" id="single-albaran-camera" accept="image/*" capture="environment" class="hidden" onchange="handleSingleAlbaranSelected(event)" style="display:none!important;position:absolute;width:0;height:0;opacity:0;pointer-events:none">
    <input type="file" id="single-albaran-gallery" accept="image/*" class="hidden" onchange="handleSingleAlbaranSelected(event)" style="display:none!important;position:absolute;width:0;height:0;opacity:0;pointer-events:none">

    <!-- CUERPO PRINCIPAL -->
    <main class="flex-1 overflow-y-auto no-scrollbar pb-[100px] md:pb-6 p-4 md:p-6 lg:p-8">
      
      <!-- 1. INICIO -->
      <section id="tab-inicio" class="tab-content space-y-4 hidden">
        <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-5 text-center shadow-lg relative overflow-hidden">
          <div class="absolute -top-12 -right-12 w-32 h-32 bg-[#00E676]/10 rounded-full blur-2xl pointer-events-none"></div>
          <div class="flex items-center justify-center space-x-2 mb-2">
            <span class="text-2xl">🏍️</span>
            <span class="text-2xl font-black text-[#00E676] tracking-wider">Motos@Motos</span>
          </div>
          <h2 id="home-driver" class="text-lg font-bold text-white tracking-wide">Andrei Ciobanu</h2>
          <p id="home-dni" class="text-xs text-slate-400 font-mono tracking-widest mt-0.5">X7950564Q</p>
          
          <div class="mt-3.5 inline-block">
            <div class="border border-[#00E676]/40 px-4 py-1.5 rounded-full bg-[#00E676]/10">
              <span id="home-status-badge" class="text-[11px] font-black text-[#00E676] tracking-wider uppercase">SIN RUTA CARGADA</span>
            </div>
          </div>

          <div id="home-route-details" class="mt-4 pt-3 border-t border-[#1C263E] grid grid-cols-3 text-left hidden">
            <div>
              <span class="text-[10px] text-slate-400 block uppercase">Ruta</span>
              <span id="home-route-name" class="text-xs font-bold text-[#00E676] truncate block">---</span>
            </div>
            <div>
              <span class="text-[10px] text-slate-400 block uppercase">Camión</span>
              <span id="home-route-plate" class="text-xs font-bold text-slate-200">2455 KVF</span>
            </div>
            <div>
              <span class="text-[10px] text-slate-400 block uppercase">Progreso</span>
              <span id="home-route-progress" class="text-xs font-bold text-[#FF007F]">0/0</span>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
          <button onclick="switchTab('nueva')" class="bg-[#0E1526] border border-[#FF007F]/40 hover:border-[#FF007F] rounded-2xl p-5 flex flex-col items-center justify-center space-y-2 active:scale-95 transition-all shadow-md">
            <span class="text-3xl">📷</span>
            <span class="text-xs font-black text-[#FF007F] tracking-wider">+ SUBIR HOJA / ALBARÁN</span>
          </button>
          <button onclick="switchTab('rutas')" class="bg-[#0E1526] border border-[#00E676]/40 hover:border-[#00E676] rounded-2xl p-5 flex flex-col items-center justify-center space-y-2 active:scale-95 transition-all shadow-md">
            <span class="text-3xl">🗺️</span>
            <span class="text-xs font-black text-[#00E676] tracking-wider" id="btn-routes-count">MIS RUTAS (0)</span>
          </button>
          <button onclick="switchTab('clientes')" class="bg-[#0E1526] border border-amber-500/40 hover:border-amber-400 rounded-2xl p-5 flex flex-col items-center justify-center space-y-2 active:scale-95 transition-all shadow-md">
            <span class="text-3xl">👥</span>
            <span class="text-xs font-black text-amber-300 tracking-wider" id="btn-clientes-count">CLIENTES (0)</span>
          </button>
          <button onclick="switchTab('motos')" class="bg-[#0E1526] border border-sky-500/40 hover:border-sky-400 rounded-2xl p-5 flex flex-col items-center justify-center space-y-2 active:scale-95 transition-all shadow-md">
            <span class="text-3xl">🏍️</span>
            <span class="text-xs font-black text-sky-300 tracking-wider" id="btn-motos-count">MOTOS (0)</span>
          </button>
          <button onclick="switchTab('observaciones')" class="bg-[#0E1526] border border-orange-500/40 hover:border-orange-400 rounded-2xl p-5 flex flex-col items-center justify-center space-y-2 active:scale-95 transition-all shadow-md">
            <span class="text-3xl">📝</span>
            <span class="text-xs font-black text-orange-300 tracking-wider" id="btn-obs-count">OBSERVACIONES (0)</span>
          </button>
          <button onclick="switchTab('buscar')" class="bg-[#0E1526] border border-[#38BDF8]/40 hover:border-[#38BDF8] rounded-2xl p-5 flex flex-col items-center justify-center space-y-2 active:scale-95 transition-all shadow-md">
            <span class="text-3xl">🔍</span>
            <span class="text-xs font-black text-white tracking-wider">BUSCADOR GLOBAL</span>
          </button>
          <button onclick="openStatsModal()" class="bg-[#0E1526] border border-[#A78BFA]/40 hover:border-[#A78BFA] rounded-2xl p-5 flex flex-col items-center justify-center space-y-2 active:scale-95 transition-all shadow-md">
            <span class="text-3xl">📊</span>
            <span class="text-xs font-black text-white tracking-wider">ESTADÍSTICAS</span>
          </button>
        </div>

        
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-3 pt-2">
          <div class="lg:col-span-3 bg-[rgba(255,255,255,0.04)] border border-white/10 rounded-2xl p-4 backdrop-blur-xl">
            <div class="flex items-center space-x-2 mb-3"><span class="text-[#FF6A00] font-bold">📊</span><h3 class="text-xs font-black text-white tracking-wider uppercase">HISTÓRICO ACUMULADO</h3></div>
            <div class="grid grid-cols-3 gap-2.5">
              <div class="bg-black/30 border border-white/5 rounded-xl p-3 text-center"><div class="text-2xl font-black text-white" id="stat-routes">0</div><div class="text-[11px] text-white/40 mt-0.5">Rutas</div></div>
              <div class="bg-black/30 border border-white/5 rounded-xl p-3 text-center"><div class="text-2xl font-black text-[#FF6A00]" id="stat-bikes">0</div><div class="text-[11px] text-white/40 mt-0.5">Motos Totales</div></div>
              <div class="bg-black/30 border border-white/5 rounded-xl p-3 text-center"><div class="text-2xl font-black text-white" id="stat-total-km">0</div><div class="text-[11px] text-white/40 mt-0.5">Km Totales</div></div>
            </div>
            <div class="mt-3"><button onclick="openStatsModal()" class="w-full py-2 rounded-xl bg-white/5 border border-white/10 text-[11px] font-bold text-white/70">Ver detalles →</button></div>
          </div>
          <div class="lg:col-span-2 bg-[rgba(255,106,0,0.08)] border border-[#FF6A00]/20 rounded-2xl p-4 backdrop-blur-xl flex flex-col">
            <div class="flex items-center justify-between mb-3"><div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-[#FF6A00] animate-pulse"></span><h3 class="text-xs font-black text-[#FF6A00] uppercase tracking-wider">🔔 Alertas</h3></div><span id="home-entregas-count" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#FF6A00]/20 text-[#FF6A00] border border-[#FF6A00]/30">0 pendientes</span></div>
            <div id="home-entregas-list" class="space-y-2 flex-1 overflow-y-auto max-h-[220px] no-scrollbar"><p class="text-[11px] text-white/30 py-6 text-center">Sin alertas pendientes</p></div>
            <div class="mt-3 pt-3 border-t border-white/5 flex gap-2"><button onclick="switchTab('ajustes')" class="flex-1 py-2 rounded-xl bg-black/30 border border-white/10 text-[10px] font-bold text-white/50">⚙️ Configurar</button><button onclick="renderHomeEntregasAlertas()" class="flex-1 py-2 rounded-xl bg-[#FF6A00]/20 border border-[#FF6A00]/30 text-[10px] font-bold text-[#FF6A00]">↻ Actualizar</button></div>
          </div>
        </div>
        <div id="home-alert-box" class="hidden"></div>
        <div id="home-entregas-alertas" class="hidden"><div id="home-entregas-list-dup" class="hidden"></div></div>

      </section>

      <!-- CLIENTES -->
      <section id="tab-clientes" class="tab-content space-y-3 hidden">
        <div class="flex items-center justify-between">
          <button onclick="switchTab('inicio')" class="text-[11px] font-bold text-slate-400 hover:text-white">← Inicio</button>
          <h2 class="text-sm font-black text-amber-300 uppercase tracking-wider">👥 Clientes</h2>
          <span class="w-12"></span>
        </div>
        <input type="search" id="clientes-search" placeholder="Buscar nombre, teléfono o localidad..." oninput="renderClientesTab()" class="w-full bg-[#0E1526] border border-[#1C263E] rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500">
        <div id="clientes-list" class="space-y-2"></div>
      </section>

      <!-- MOTOS -->
      <section id="tab-motos" class="tab-content space-y-3 hidden">
        <div class="flex items-center justify-between">
          <button onclick="switchTab('inicio')" class="text-[11px] font-bold text-slate-400 hover:text-white">← Inicio</button>
          <h2 class="text-sm font-black text-sky-300 uppercase tracking-wider">🏍️ Motos</h2>
          <span class="w-12"></span>
        </div>
        <input type="search" id="motos-search" placeholder="Buscar moto o matrícula..." oninput="renderMotosTab()" class="w-full bg-[#0E1526] border border-[#1C263E] rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none focus:border-sky-500">
        <div id="motos-list" class="space-y-2"></div>
      </section>

      <!-- OBSERVACIONES -->
      <section id="tab-observaciones" class="tab-content space-y-3 hidden">
        <div class="flex items-center justify-between">
          <button onclick="switchTab('inicio')" class="text-[11px] font-bold text-slate-400 hover:text-white">← Inicio</button>
          <h2 class="text-sm font-black text-orange-300 uppercase tracking-wider">📝 Observaciones</h2>
          <button onclick="openObsModal()" class="text-[11px] font-black text-[#00E676]">+ Nueva</button>
        </div>
        <div id="observaciones-list" class="space-y-2"></div>
      </section>

      <!-- 2. MIS RUTAS -->
      <section id="tab-rutas" class="tab-content space-y-4 hidden">
        <div id="routes-empty" class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-8 text-center space-y-4">
          <div class="w-16 h-16 mx-auto rounded-full bg-[#00E676]/10 border border-[#00E676]/30 flex items-center justify-center text-[#00E676] text-2xl">
            🗺️
          </div>
          <div>
            <h3 class="text-base font-bold text-white">No hay rutas activas</h3>
            <p class="text-xs text-slate-400 mt-1">Fotografía tu hoja física para cargar automáticamente el itinerario secuencial.</p>
          </div>
          <button onclick="switchTab('nueva')" class="w-full py-3 bg-[#FF007F] hover:bg-[#E11D48] text-white font-black rounded-xl text-xs active:scale-95 transition-all shadow-lg glow-pink">
            📷 Subir Hoja de Ruta Ahora
          </button>
        </div>

        <div id="routes-pills" class="flex space-x-2 overflow-x-auto no-scrollbar pb-1 hidden"></div>

        <div id="routes-header-card" class="bg-[#0E1526] p-4 rounded-2xl border border-[#1C263E] space-y-3 hidden relative overflow-hidden">
          <div class="flex items-start justify-between">
            <div>
              <h2 id="route-title" class="text-sm font-black text-[#00E676] uppercase tracking-wider"></h2>
              <p id="route-subtitle" class="text-xs text-slate-400 font-mono mt-0.5"></p>
            </div>
            <div class="flex items-center space-x-2">
              <button onclick="exportModernRoutePDF()" class="py-2 px-3 rounded-xl bg-[#FF007F] hover:bg-[#E11D48] text-white font-black text-xs flex items-center space-x-1.5 active:scale-95 transition-all shadow-lg glow-pink" title="Descargar Reporte General de Ruta">
                <span>📊</span>
                <span>PDF RUTA</span>
              </button>
              <button onclick="confirmDeleteActiveRoute()" class="p-2 rounded-xl bg-[#090E1A] border border-red-800/40 text-red-400 hover:bg-red-900/40 transition-colors" title="Eliminar ruta">
                🗑️
              </button>
            </div>
          </div>
          <div class="flex items-center justify-between pt-2 border-t border-[#1C263E] text-xs">
            <span class="text-slate-400">Chófer: <strong id="route-driver" class="text-slate-200"></strong></span>
            <span id="route-badge-progress" class="px-2.5 py-0.5 rounded-full font-bold bg-[#00E676]/20 text-[#00E676] border border-[#00E676]/40"></span>
          </div>
          <div class="flex items-center justify-between pt-2 border-t border-[#1C263E]/60 text-xs">
            <div class="flex items-center gap-2">
              <span class="text-slate-400">⛽ Gasoil:</span>
              <strong id="route-gasoil" class="text-[#FF007F] font-mono">0 €</strong>
              <span id="route-gasoil-count" class="text-[10px] text-slate-500">(0)</span>
            </div>
            <div class="flex items-center gap-1.5">
              <button onclick="openGasoilModal()" class="px-2.5 py-1 rounded-full bg-[#FF007F]/20 border border-[#FF007F]/40 text-[#FF007F] font-bold text-[10px] hover:bg-[#FF007F]/30 transition-colors">📋 Ver/ Añadir</button>
            </div>
          </div>
          <div id="route-gasoil-preview" class="mt-2 hidden">
            <div class="bg-[#090E1A] border border-[#1C263E] rounded-lg p-2 space-y-1 max-h-[100px] overflow-y-auto text-[10px] font-mono">
            </div>
          </div>
        </div>

        <div id="stops-list" class="timeline-container space-y-0"></div>
      </section>

      <!-- 3. AÑADIR HOJA / ALBARÁN -->
      <section id="tab-nueva" class="tab-content space-y-4">
        <div id="api-key-warning" class="bg-[#FF007F]/10 border border-[#FF007F]/30 rounded-2xl p-4 flex items-start space-x-3 hidden">
          <span class="text-[#FF007F] text-xl flex-shrink-0">⚠️</span>
          <div class="text-xs">
            <h4 class="font-bold text-[#FF007F]">Clave API no configurada</h4>
            <p class="text-slate-300 mt-0.5">Para digitalizar con IA, introduce tu clave de Google AI Studio en Ajustes.</p>
            <button onclick="switchTab('ajustes')" class="mt-2 text-[#00E676] font-bold underline block">Ir a Ajustes ➔</button>
          </div>
        </div>

        <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-5 text-center shadow-lg">
          <div class="w-14 h-14 mx-auto rounded-full bg-[#00E676]/10 border border-[#00E676]/30 flex items-center justify-center text-[#00E676] text-2xl mb-2 glow-green">
            📑
          </div>
          <h2 class="text-base font-bold text-white">Digitalizar Hoja de Ruta Completa</h2>
          <p class="text-xs text-slate-400 mt-1 max-w-xs mx-auto">
            Extrae automáticamente toda la secuencia de paradas, motos y albaranes de la hoja física.
          </p>

          <input type="file" id="camera-input" accept="image/*" capture="environment" class="hidden" onchange="handleFileSelected(event)" style="display:none!important;position:absolute;width:0;height:0;opacity:0;pointer-events:none">
          <input type="file" id="gallery-input" accept="image/*" class="hidden" onchange="handleFileSelected(event)" style="display:none!important;position:absolute;width:0;height:0;opacity:0;pointer-events:none">

          <div class="mt-4 grid grid-cols-2 gap-3">
            <button onclick="openNativeCamera()" class="bg-[#00E676] hover:bg-[#00c966] text-slate-950 font-black py-3 px-3 rounded-xl flex items-center justify-center space-x-2 active:scale-95 transition-all shadow-lg glow-green text-xs">
              <span>📷 Foto Hoja</span>
            </button>
            <button onclick="openGalleryPicker()" class="bg-[#1C263E] hover:bg-[#253354] text-white font-bold py-3 px-3 rounded-xl flex items-center justify-center space-x-2 active:scale-95 transition-all border border-[#2D3D63] text-xs">
              <span>📁 Galería</span>
            </button>
          </div>
        </div>

        <div class="bg-[#0E1526] border border-[#FF007F]/40 rounded-2xl p-5 text-center shadow-lg relative overflow-hidden">
          <div class="absolute -top-10 -left-10 w-24 h-24 bg-[#FF007F]/10 rounded-full blur-xl pointer-events-none"></div>
          <div class="w-14 h-14 mx-auto rounded-full bg-[#FF007F]/10 border border-[#FF007F]/30 flex items-center justify-center text-[#FF007F] text-2xl mb-2 glow-pink">
            📄
          </div>
          <h2 class="text-base font-bold text-white">Añadir Albarán a la Ruta</h2>
          <p class="text-xs text-slate-400 mt-1 max-w-xs mx-auto">
            ¿Una moto nueva de última hora? Fotografía el albarán físico y la IA lo insertará en tu ruta activa.
          </p>

          <div class="mt-3 text-left">
            <label class="text-[10px] text-slate-400 font-bold uppercase block mb-1">Añadir a la ruta:</label>
            <select id="single-albaran-target-route" class="w-full bg-[#090E1A] border border-[#1C263E] rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-[#00E676]">
            </select>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-3">
            <button onclick="openSingleAlbaranCamera()" class="bg-[#FF007F] hover:bg-[#e11d48] text-white font-black py-3 px-3 rounded-xl flex items-center justify-center space-x-2 active:scale-95 transition-all shadow-lg glow-pink text-xs">
              <span>📷 Foto Albarán</span>
            </button>
            <button onclick="openSingleAlbaranGallery()" class="bg-[#1C263E] hover:bg-[#253354] text-white font-bold py-3 px-3 rounded-xl flex items-center justify-center space-x-2 active:scale-95 transition-all border border-[#2D3D63] text-xs">
              <span>📁 Galería</span>
            </button>
          </div>

          <div id="scan-loading" class="mt-4 p-4 rounded-xl bg-[#00E676]/10 border border-[#00E676]/30 text-[#00E676] flex flex-col items-center space-y-2 hidden">
            <div class="w-6 h-6 border-2 border-[#00E676] border-t-transparent rounded-full animate-spin"></div>
            <span id="scan-status-text" class="text-xs font-bold">Procesando con Gemini IA...</span>
          </div>
        </div>

        <div id="saved-routes-container" class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-4 hidden">
          <h3 class="text-xs font-bold text-slate-300 mb-2.5 flex items-center justify-between">
            <span id="saved-routes-count">Rutas Guardadas (0)</span>
            <span class="text-[10px] text-[#00E676]">Toca para abrir</span>
          </h3>
          <div id="saved-routes-list" class="space-y-2"></div>
        </div>
      </section>

      <!-- 4. PERITAJE INTEGRADO (CON BOTÓN DE EXPORTAR PDF HD) -->
      <section id="tab-peritaje" class="tab-content space-y-3 hidden">
        <input type="file" id="peritaje-photo-input" accept="image/*" multiple class="hidden" onchange="handlePeritajeFiles(event)" style="display:none!important;position:absolute;width:0;height:0;opacity:0;pointer-events:none">

        <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-4">
          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-lg">🛡️</span>
                <h2 class="text-sm font-black text-white">Peritaje IA integrado</h2>
              </div>
              <p class="text-[10px] text-slate-400 mt-1">La inspección queda vinculada directamente al albarán/moto de la ruta.</p>
            </div>
            <span id="peritaje-status" class="text-[9px] px-2 py-1 rounded-full bg-slate-800 text-slate-400 font-bold">SIN EXPEDIENTE</span>
          </div>

          <div id="peritaje-exp-card" class="mt-3 bg-[#090E1A] border border-[#1C263E] rounded-xl p-3 hidden">
            <div class="flex items-center justify-between">
              <div>
                <div id="peritaje-exp-title" class="text-xs font-black text-[#00E676] font-mono">S/N</div>
                <div id="peritaje-exp-moto" class="text-xs font-bold text-white mt-0.5">Motocicleta</div>
                <div id="peritaje-exp-client" class="text-[10px] text-slate-400 mt-0.5">Cliente</div>
              </div>
              <button onclick="switchTab('rutas')" class="px-2.5 py-1.5 rounded-lg bg-[#1C263E] text-slate-300 text-[10px] font-bold hover:bg-[#253354]">← Ruta</button>
            </div>
          </div>

          <div id="peritaje-empty" class="mt-4 text-center py-8 border border-dashed border-[#1C263E] rounded-xl">
            <div class="text-3xl mb-2">🏍️</div>
            <p class="text-xs font-bold text-slate-300">Selecciona una moto desde la ruta</p>
            <p class="text-[10px] text-slate-500 mt-1">Después podrás añadir fotos en HD y analizarlas.</p>
            <button onclick="switchTab('rutas')" class="mt-3 px-4 py-2 rounded-xl bg-[#00E676] text-slate-950 text-xs font-black glow-green">Abrir rutas</button>
          </div>

          <div id="peritaje-workspace" class="hidden mt-3 space-y-3">
            
            <!-- BOTÓN EXPORTAR PERITAJE EN PDF HD -->
            <button onclick="exportPeritajeHD_PDF()" class="w-full py-3 rounded-xl bg-[#FF007F] hover:bg-[#E11D48] text-white font-black text-xs flex items-center justify-center space-x-2 shadow-lg glow-pink active:scale-95 transition-all">
              <span>📄</span>
              <span>EXPORTAR INFORME PERITAJE PDF (HD)</span>
            </button>

            <div class="grid grid-cols-2 gap-2">
              <button onclick="document.getElementById('peritaje-photo-input').click()" class="py-2.5 rounded-xl bg-[#1C263E] hover:bg-[#253354] border border-[#2D3D63] text-white font-black text-xs active:scale-95 transition-all">📷 Añadir fotos HD</button>
              <button onclick="analyzeAllPeritaje()" id="btn-analyze-all" class="py-2.5 rounded-xl bg-[#00E676] hover:bg-[#00c966] text-slate-950 font-black text-xs glow-green active:scale-95 transition-all">🤖 Analizar todo</button>
            </div>

            <div id="peritaje-photos" class="grid grid-cols-3 gap-2"></div>

            <div id="peritaje-stage" class="peritaje-stage hidden">
              <div class="px-3 py-2 bg-[#070A12] border-b border-[#1C263E] flex items-center justify-between">
                <span id="peritaje-stage-title" class="text-[10px] font-bold text-slate-300 truncate">Foto</span>
                <span id="peritaje-stage-count" class="text-[9px] text-slate-500 font-mono">0 daños</span>
              </div>
              <div class="peritaje-img-wrap" id="peritaje-image-wrap">
                <img id="peritaje-main-img" src="" alt="Foto de peritaje">
                <div id="peritaje-boxes" class="absolute inset-0 pointer-events-none"></div>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-2">
              <div class="bg-[#090E1A] border border-[#1C263E] rounded-xl p-2 text-center"><span class="text-[8px] text-slate-500 block">FOTOS</span><b id="per-kpi-photos" class="text-sm text-white">0</b></div>
              <div class="bg-[#090E1A] border border-[#1C263E] rounded-xl p-2 text-center"><span class="text-[8px] text-slate-500 block">DAÑOS</span><b id="per-kpi-damages" class="text-sm text-[#00E676]">0</b></div>
              <div class="bg-[#090E1A] border border-[#1C263E] rounded-xl p-2 text-center"><span class="text-[8px] text-slate-500 block">GRAVES</span><b id="per-kpi-severe" class="text-sm text-[#FF007F]">0</b></div>
            </div>

            <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-3">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-xs font-black text-white">Daños consolidados</h3>
                <span id="per-score" class="text-[10px] font-mono text-[#00E676]">Score —</span>
              </div>
              <div id="peritaje-damages-list" class="space-y-2">
                <p class="text-[10px] text-slate-500 text-center py-5">Todavía no hay daños analizados.</p>
              </div>
            </div>

            <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-3">
              <h3 class="text-xs font-black text-[#00E676] mb-2">Observaciones del peritaje</h3>
              <textarea id="peritaje-notes" rows="3" placeholder="Observaciones generales..." class="w-full bg-[#090E1A] border border-[#1C263E] rounded-xl p-2.5 text-xs text-white resize-none focus:outline-none focus:border-[#00E676]"></textarea>
              <button onclick="savePeritajeNotes()" class="mt-2 w-full py-2 rounded-xl bg-[#1C263E] text-slate-200 text-xs font-bold hover:bg-[#253354]">💾 Guardar observaciones</button>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. BUSCADOR GLOBAL -->
      <section id="tab-buscar" class="tab-content space-y-3 hidden">
        <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-4">
          <div class="flex items-center space-x-2 mb-2">
            <span class="text-[#00E676] text-base">🔍</span>
            <h3 class="text-xs font-black text-[#00E676] uppercase tracking-wider">Buscador en Todo el Historial</h3>
          </div>
          <p class="text-[11px] text-slate-400 mb-3">Busca por albarán, moto, cliente, población, daños, matrícula o fecha en todas las rutas.</p>
          
          <div class="relative">
            <input type="text" id="search-input" oninput="renderSearchResults()" placeholder="Ej: F-1442, Yamaha, Francisco, 2455 KVF, Madrid..." class="w-full bg-[#090E1A] border border-[#1C263E] focus:border-[#00E676] rounded-xl px-4 py-3 pl-10 pr-10 text-xs text-white placeholder-slate-500 focus:outline-none transition-colors">
            <span class="absolute left-3.5 top-3.5 text-slate-500">🔎</span>
            <button onclick="clearSearch()" id="btn-clear-search" class="absolute right-3 top-3 text-slate-400 hover:text-white hidden">✕</button>
          </div>
        </div>

        <div class="text-[11px] text-slate-400 font-medium px-1 flex justify-between">
          <span>Coincidencias encontradas:</span>
          <span id="search-results-count" class="font-bold text-[#00E676]">0</span>
        </div>

        <div id="search-results-list" class="space-y-2.5"></div>
      </section>

      <!-- 6. AJUSTES Y BACKUP -->
      <section id="tab-ajustes" class="tab-content space-y-4 hidden">

                <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-4 space-y-3">
          <h3 class="text-xs font-black uppercase tracking-wider" style="color:var(--theme-primary)">🎨 Aspecto / Temas (5)</h3>
          <p class="text-[11px] text-slate-400">Elige un aspecto, cambia TODA la app al instante.</p>
          <div class="grid grid-cols-1 gap-2.5">
            <div class="theme-card bg-[#0A0A0B] border border-[#FF6A00]/40" data-theme-card="ktm" onclick="setTheme('ktm')">
              <div class="check">✓</div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#FF6A00] flex items-center justify-center text-black font-black">K</div>
                <div><div class="text-sm font-black text-white">KTM NARANJA</div><div class="text-[11px] text-white/60">Naranja mecánico - Original</div></div>
              </div>
            </div>
            <div class="theme-card bg-[#0A0A0B] border border-[#E60012]/40" data-theme-card="ducati" onclick="setTheme('ducati')">
              <div class="check">✓</div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#E60012] flex items-center justify-center text-white font-black">D</div>
                <div><div class="text-sm font-black text-white">DUCATI RED</div><div class="text-[11px] text-white/60">Rojo corsa - Toda la app en rojo</div></div>
              </div>
            </div>
            <div class="theme-card bg-[#111410] border border-[#8B9A6B]/40" data-theme-card="military" onclick="setTheme('military')">
              <div class="check">✓</div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#8B9A6B] flex items-center justify-center text-black font-black">M</div>
                <div><div class="text-sm font-black text-white">MILITARY OLIVA</div><div class="text-[11px] text-white/60">Verde táctico militar</div></div>
              </div>
            </div>
            <div class="theme-card bg-white border border-slate-300" data-theme-card="light" onclick="setTheme('light')">
              <div class="check">✓</div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-white border border-slate-300 flex items-center justify-center text-slate-900 font-black">B</div>
                <div><div class="text-sm font-black text-slate-900">BLANCO DÍA</div><div class="text-[11px] text-slate-600">Fondo blanco, ideal sol</div></div>
              </div>
            </div>
            <div class="theme-card bg-black border border-white/20" data-theme-card="dark" onclick="setTheme('dark')">
              <div class="check">✓</div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-black border border-white/30 flex items-center justify-center text-white font-black">N</div>
                <div><div class="text-sm font-black text-white">NEGRO DARK</div><div class="text-[11px] text-white/60">Negro puro - Máximo contraste</div></div>
              </div>
            </div>
          </div>
        </div>
            </div>

                  <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-4">
          <h3 class="text-xs font-bold text-[#00E676] uppercase tracking-wider mb-3">Clave API Gemini (Google AI Studio)</h3>
          <p class="text-[11px] text-slate-300 mb-2">Pega aquí tu clave de Google AI Studio (puede empezar por AIzaSy... o AQ.Ab...):</p>
          <input type="password" id="api-key-input" placeholder="AIzaSy... o AQ.Ab..." class="w-full bg-[#090E1A] border border-[#1C263E] rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none focus:border-[#00E676] font-mono mb-2">
          <button onclick="saveApiKey()" class="w-full py-2.5 bg-[#00E676] hover:bg-[#00c966] text-slate-950 font-black rounded-xl text-xs transition-colors glow-green shadow-md">
            Guardar y Activar Clave API
          </button>
        </div>

        
        <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-4 space-y-3">
          <h3 class="text-xs font-bold text-[#00E676] uppercase tracking-wider">🔔 Alertas de entregas</h3>
          <p class="text-[11px] text-slate-400">Avisos en Inicio de albaranes pendientes de la ruta activa, y minutos para el mensaje de WhatsApp.</p>
          <label class="flex items-center justify-between gap-3 cursor-pointer">
            <span class="text-xs text-slate-200">Mostrar alertas en Inicio</span>
            <input type="checkbox" id="cfg-alertas-enabled" onchange="saveAlertasConfig()" class="w-5 h-5 accent-[#00E676]">
          </label>
          <div class="flex items-center justify-between gap-3">
            <span class="text-xs text-slate-200">Avisar con antelación</span>
            <select id="cfg-alertas-minutos" onchange="saveAlertasConfig()" class="bg-[#090E1A] border border-[#1C263E] text-white rounded-xl px-2 py-1.5 text-xs font-mono">
              <option value="15">15 min</option>
              <option value="30" selected>30 min</option>
              <option value="45">45 min</option>
              <option value="60">60 min</option>
            </select>
          </div>
          <label class="flex items-center justify-between gap-3 cursor-pointer">
            <span class="text-xs text-slate-200">Solo pendientes (no hechos/anulados)</span>
            <input type="checkbox" id="cfg-alertas-solo-pendientes" checked onchange="saveAlertasConfig()" class="w-5 h-5 accent-[#00E676]">
          </label>
        </div>

        <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-xs font-bold text-amber-400 uppercase tracking-wider">🖥️ Consola de depuración</h3>
            <div class="flex gap-1.5">
              <button onclick="copyDebugLog()" class="text-[10px] font-bold text-[#00E676] hover:text-white px-2 py-1 rounded-lg bg-[#1C263E] border border-[#00E676]/40">📋 Copiar</button>
              <button onclick="clearDebugLog()" class="text-[10px] font-bold text-slate-400 hover:text-white px-2 py-1 rounded-lg bg-[#1C263E]">Limpiar</button>
            </div>
          </div>
          <p class="text-[10px] text-slate-500 mb-2">Aquí verás el proceso al subir hojas, albaranes o analizar peritajes. Si hay error, aparece aquí el detalle.</p>
          <div id="debug-console" class="bg-[#050810] border border-[#1C263E] rounded-xl p-2.5 h-48 overflow-y-auto no-scrollbar font-mono text-[10px] text-slate-300 leading-relaxed whitespace-pre-wrap select-text" style="user-select:text;-webkit-user-select:text;">
            <span class="text-slate-600">Esperando actividad...</span>
          </div>
        </div>

        <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-4 space-y-3">
          <h3 class="text-xs font-bold text-[#FF007F] uppercase tracking-wider">Copias de Seguridad (Backup & Restore)</h3>
          <p class="text-[11px] text-slate-300">Descarga tus datos a la memoria del teléfono o restaura un archivo previo:</p>
          
          <div class="grid grid-cols-2 gap-2">
            <button onclick="exportBackup(false)" class="py-2.5 px-2 bg-[#090E1A] hover:bg-[#1C263E] text-[#00E676] border border-[#00E676]/40 rounded-xl text-[11px] font-bold transition-all">
              💾 Backup Ligero (Datos)
            </button>
            <button onclick="exportBackup(true)" class="py-2.5 px-2 bg-[#090E1A] hover:bg-[#1C263E] text-[#FF007F] border border-[#FF007F]/40 rounded-xl text-[11px] font-bold transition-all">
              📦 Backup Completo (Fotos 12MP)
            </button>
          </div>

          <button onclick="triggerRestoreBackup()" class="w-full py-2.5 bg-[#1C263E] hover:bg-[#253354] text-slate-200 border border-[#2D3D63] rounded-xl text-xs font-bold transition-colors">
            📥 Restaurar Copia de Seguridad (.json)
          </button>
        </div>

        <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-4">
          <h3 class="text-xs font-bold text-[#38BDF8] uppercase tracking-wider mb-3">☁️ Nube Supabase</h3>
          <p class="text-[11px] text-slate-300 mb-2">
            Fotos HD + <strong>rutas sincronizadas</strong> entre todos tus móviles.
          </p>
          <div class="text-[10px] font-mono text-slate-400 bg-[#090E1A] rounded-lg p-2.5 border border-[#1C263E] space-y-1">
            <div>Proyecto: <span class="text-[#00E676]">bvjjdqywzbpvxjksderg</span></div>
            <div>Bucket fotos: <span class="text-[#00E676]">fotos</span></div>
            <div>Tabla rutas: <span class="text-[#00E676]">routes</span></div>
            <div class="pt-1 text-slate-500">Necesitas crear la tabla <strong>routes</strong> en Supabase (SQL Editor). Ver instrucciones.</div>
          </div>
        </div>

        <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl p-4">
          <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-3">Datos del Chófer</h3>
          <div class="space-y-2 text-xs">
            <div class="flex justify-between py-1.5 border-b border-[#1C263E]">
              <span class="text-slate-400">Conductor:</span>
              <span id="settings-driver" class="font-bold text-white">Andrei Ciobanu</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-[#1C263E]">
              <span class="text-slate-400">DNI / NIE:</span>
              <span id="settings-dni" class="font-mono font-bold text-white">X7950564Q</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-[#1C263E]">
              <span class="text-slate-400">Matrícula:</span>
              <span id="settings-plate" class="font-mono font-bold text-[#00E676]">2455 KVF</span>
            </div>
            <div class="flex justify-between py-1.5">
              <span class="text-slate-400">Empresa:</span>
              <span class="font-bold text-slate-200">Motos & Motos Trans S.L.</span>
            </div>
          </div>
        </div>
      </section>

    </main>

    <!-- MODAL VISOR HD DE FOTOGRAFÍAS -->
    <div id="modal-view-photo" class="fixed inset-0 bg-black/95 backdrop-blur-md z-50 flex flex-col justify-between p-4 hidden">
      <div class="flex items-center justify-between text-white border-b border-[#1C263E] pb-3">
        <div>
          <h3 id="modal-photo-title" class="font-bold text-sm text-[#00E676]">Inspección HD</h3>
          <p id="modal-photo-subtitle" class="text-[10px] text-slate-400 font-mono"></p>
        </div>
        <button onclick="closePhotoModal()" class="p-2 rounded-xl bg-[#0E1526] text-slate-300 hover:text-white">✕</button>
      </div>

      <div class="flex-1 flex items-center justify-center my-3 overflow-auto rounded-xl bg-[#090E1A] border border-[#1C263E]">
        <img id="modal-photo-img" src="" alt="Foto Inspección" class="max-h-[70vh] max-w-full object-contain cursor-zoom-in" onclick="toggleZoomPhoto(this)">
      </div>

      <div class="flex space-x-2 pt-2 border-t border-[#1C263E]">
        <button onclick="deleteCurrentModalPhoto()" class="w-full py-3 bg-red-950/80 hover:bg-red-900/80 border border-red-800/80 text-red-300 font-bold rounded-xl text-xs flex items-center justify-center space-x-1 transition-colors">
          <span>🗑️ Eliminar Esta Fotografía</span>
        </button>
      </div>
    </div>

    <!-- MODAL FIRMA DIGITAL TÁCTIL -->
    <div id="modal-signature" class="fixed inset-0 bg-black/95 backdrop-blur-md z-50 flex flex-col justify-between p-4 hidden">
      <div class="flex items-center justify-between text-white border-b border-[#1C263E] pb-2">
        <div>
          <h3 class="font-bold text-sm text-[#00E676]">Firma Digital del Cliente</h3>
          <p id="modal-signature-subtitle" class="text-[10px] text-slate-400 font-mono">Firme con el dedo en el recuadro</p>
        </div>
        <button onclick="closeSignatureModal()" class="p-2 rounded-xl bg-[#0E1526] text-slate-300 hover:text-white">✕</button>
      </div>

      <div id="signature-container" class="flex-1 my-3 bg-[#090E1A] border-2 border-dashed border-[#00E676]/50 rounded-2xl relative overflow-hidden flex items-center justify-center">
        <canvas id="signature-pad" class="w-full h-full cursor-crosshair" style="touch-action: none;"></canvas>
        <div class="absolute bottom-2 text-[10px] text-slate-500 pointer-events-none uppercase font-bold tracking-wider">
          Recepción Conforme • Motos@Motos
        </div>
      </div>

      <div class="flex space-x-2 pt-2 border-t border-[#1C263E]">
        <button onclick="clearSignatureCanvas()" class="py-3 px-5 bg-[#0E1526] hover:bg-[#1C263E] text-slate-300 hover:text-white font-bold rounded-xl text-xs">
          Borrar
        </button>
        <button onclick="saveSignaturePad()" class="flex-1 py-3 bg-[#00E676] hover:bg-[#00c966] text-slate-950 font-black rounded-xl text-xs shadow-lg active:scale-95 transition-all glow-green">
          ✓ Guardar Firma Conforme
        </button>
      </div>
    </div>

    <!-- MODAL BORRAR RUTA -->
    <div id="modal-delete" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
      <div class="bg-[#0E1526] border border-red-900/50 w-full max-w-sm rounded-2xl p-5 shadow-2xl">
        <div class="flex items-center space-x-2 text-red-400 mb-3">
          <span class="text-xl">🗑️</span>
          <h3 class="font-bold text-base text-white">¿Eliminar esta ruta?</h3>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed mb-4">
          Se borrará todo el itinerario, albaranes, fotos de inspección en 12 MP y firmas. Esta acción no se puede deshacer.
        </p>
        <div class="flex space-x-2">
          <button onclick="closeDeleteModal()" class="flex-1 py-2.5 bg-[#1C263E] text-slate-200 font-bold rounded-xl text-xs">
            Cancelar
          </button>
          <button onclick="executeDeleteRoute()" class="flex-1 py-2.5 bg-[#FF007F] text-white font-bold rounded-xl text-xs shadow-lg glow-pink">
            Sí, Eliminar
          </button>
        </div>
      </div>
    </div>

    <!-- MODAL INCIDENCIA -->
    <div id="modal-incident" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
      <div class="bg-[#0E1526] border border-[#1C263E] w-full max-w-sm rounded-2xl p-5 shadow-2xl relative">
        <button onclick="closeIncidentModal()" class="absolute top-4 right-4 text-slate-400">✕</button>
        <div class="flex items-center space-x-2 text-[#FF007F] mb-3">
          <span class="text-xl">⚠️</span>
          <h3 id="modal-incident-title" class="font-bold text-sm text-white">Registrar Incidencia</h3>
        </div>
        <div class="space-y-3 text-xs">
          <div>
            <label class="text-slate-400 block mb-1 font-semibold">Tipo:</label>
            <select id="incident-type-select" class="w-full bg-[#090E1A] border border-[#1C263E] rounded-xl p-2.5 text-white">
              <option value="Cliente ausente">Cliente ausente / No contesta</option>
              <option value="Dirección incorrecta">Dirección inaccesible</option>
              <option value="Problema con la moto">Problema o daño en la moto</option>
              <option value="Retraso tráfico">Retraso importante en carretera</option>
              <option value="Otro motivo">Otro motivo</option>
            </select>
          </div>
          <div>
            <label class="text-slate-400 block mb-1 font-semibold">Detalles:</label>
            <textarea id="incident-text-input" rows="3" placeholder="Observaciones para el parte..." class="w-full bg-[#090E1A] border border-[#1C263E] rounded-xl p-2.5 text-white placeholder-slate-600 resize-none"></textarea>
          </div>
        </div>
        <div class="mt-4 flex space-x-2">
          <button onclick="closeIncidentModal()" class="flex-1 py-2.5 bg-[#1C263E] text-slate-300 font-bold rounded-xl text-xs">Cancelar</button>
          <button onclick="saveIncident()" class="flex-1 py-2.5 bg-[#FF007F] text-white font-bold rounded-xl text-xs shadow-lg glow-pink">Guardar</button>
        </div>
      </div>
    </div>

    <!-- MODAL STATS / INFORMES -->
    <div id="modal-stats" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
      <div class="bg-[#0E1526] border border-[#1C263E] w-full max-w-sm md:max-w-2xl lg:max-w-3xl rounded-2xl p-5 md:p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto no-scrollbar">
        <button onclick="closeStatsModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white">✕</button>
        
        <div class="flex items-center space-x-2 text-[#00E676] mb-3">
          <span class="text-xl">📊</span>
          <h3 class="font-bold text-base text-white">Informes y Arqueo de Caja</h3>
        </div>

        <div class="bg-[#090E1A] border border-[#00E676]/30 rounded-xl p-3.5 space-y-2 mb-4">
          <div class="text-[11px] font-black text-[#00E676] tracking-wider uppercase flex items-center justify-between">
            <span>📈 TOTAL ACUMULADO</span>
            <span id="stats-global-count" class="text-slate-400 font-normal">0 rutas</span>
          </div>

          <div class="grid grid-cols-2 gap-2 pt-1 text-xs">
            <div class="bg-[#0E1526] p-2.5 rounded-lg border border-[#1C263E]">
              <span class="text-[10px] text-slate-400 block">Kilómetros Totales</span>
              <span id="stats-global-km" class="text-sm font-black text-white font-mono">0 km</span>
            </div>
            <div class="bg-[#0E1526] p-2.5 rounded-lg border border-[#1C263E]">
              <span class="text-[10px] text-slate-400 block">Tiempo Conducción</span>
              <span id="stats-global-time" class="text-sm font-black text-[#00E676] font-mono">0h 0m</span>
            </div>
            <div class="bg-[#0E1526] p-2.5 rounded-lg border border-[#1C263E]">
              <span class="text-[10px] text-slate-400 block">Gasto Gasoil Total</span>
              <span id="stats-global-gasoil" class="text-sm font-black text-[#FF007F] font-mono">0 €</span>
            </div>
            <div class="bg-[#0E1526] p-2.5 rounded-lg border border-[#1C263E]">
              <span class="text-[10px] text-slate-400 block">Motos Transportadas</span>
              <span id="stats-global-bikes" class="text-sm font-black text-[#00E676] font-mono">0</span>
            </div>
          </div>
        </div>

        <div class="space-y-3 text-xs">
          <div>
            <label class="text-slate-300 block mb-1 font-bold">Seleccionar Hoja de Ruta:</label>
            <select id="stats-route-select" onchange="onSelectStatsRoute(this.value)" class="w-full bg-[#090E1A] border border-[#1C263E] rounded-xl p-2.5 text-white focus:outline-none focus:border-[#00E676] font-medium">
            </select>
          </div>

          <div id="stats-selected-card" class="bg-[#090E1A] p-3 rounded-xl border border-[#1C263E] space-y-2">
            <div class="flex justify-between items-center pb-1.5 border-b border-[#1C263E]">
              <span class="text-slate-400 font-semibold">Distancia del Día:</span>
              <span id="stats-route-km" class="font-bold text-white font-mono">0 km</span>
            </div>
            <div class="flex justify-between items-center pb-1.5 border-b border-[#1C263E]">
              <span class="text-slate-400 font-semibold">Tiempo Estimado:</span>
              <span id="stats-route-time" class="font-bold text-[#00E676] font-mono">0h 0m</span>
            </div>
            
            <div class="p-2 bg-[#0E1526] border border-[#1C263E] rounded-lg space-y-1">
              <div class="flex justify-between items-center text-[#00E676] font-bold">
                <span>💵 Cobrado en Efectivo:</span>
                <span id="stats-route-cash" class="font-mono text-sm">0 €</span>
              </div>
              <div class="flex justify-between items-center text-[#38BDF8] font-bold">
                <span>📲 Pagado por Bizum:</span>
                <span id="stats-route-bizum" class="font-mono text-sm">0 €</span>
              </div>
            </div>

            <div class="flex justify-between items-center pb-1.5 border-b border-[#1C263E]">
              <span class="text-slate-400 font-semibold">⛽ Gasto Gasoil:</span>
              <div class="flex items-center gap-2">
                <span id="stats-route-gasoil" class="font-bold text-[#FF007F] font-mono">0 €</span>
                <button onclick="editGasoilFromStats()" class="px-2 py-0.5 rounded-full bg-[#1C263E] border border-[#FF007F]/30 text-[#FF007F] text-[10px] font-bold">✏️</button>
              </div>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-slate-400 font-semibold">Progreso Paradas:</span>
              <span id="stats-route-progress" class="font-bold text-[#00E676] font-mono">0 / 0</span>
            </div>
          </div>
        </div>

        <button onclick="closeStatsModal()" class="mt-5 w-full py-2.5 bg-[#00E676] hover:bg-[#00c966] text-slate-950 font-black rounded-xl text-xs transition-colors glow-green">
          Cerrar Informe
        </button>
      </div>
    </div>

  </div>

    
    <!-- MODAL GASOIL HISTORIAL - TIPO EXCEL -->
    <div id="modal-gasoil" class="fixed inset-0 z-50 hidden bg-black/80 flex items-end sm:items-center justify-center p-3">
      <div class="bg-[#0E1526] border border-[#FF007F]/30 rounded-2xl w-full max-w-md max-h-[85vh] flex flex-col overflow-hidden">
        <div class="p-4 border-b border-[#1C263E] flex items-center justify-between bg-[#090E1A]">
          <h3 class="text-sm font-black text-[#FF007F] uppercase tracking-wider flex items-center gap-2">
            <span>⛽</span> Historial Gasoil
          </h3>
          <button onclick="closeGasoilModal()" class="text-slate-400 hover:text-white text-lg w-8 h-8 rounded-full bg-[#1C263E] flex items-center justify-center">✕</button>
        </div>
        
        <div class="p-4 space-y-3 overflow-y-auto flex-1 no-scrollbar">
          <!-- Form añadir con cálculo automático precio/litro -->
          <div class="bg-[#090E1A] border border-[#1C263E] rounded-xl p-3 space-y-3">
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="text-[10px] text-slate-400 font-bold uppercase">Importe € *</label>
                <input id="gasoil-importe" type="number" inputmode="decimal" placeholder="100" oninput="updateGasoilPrecioPreview()" class="w-full bg-[#0E1526] border border-[#1C263E] rounded-lg px-2.5 py-2 text-sm text-white focus:border-[#FF007F] outline-none">
              </div>
              <div>
                <label class="text-[10px] text-slate-400 font-bold uppercase">Litros</label>
                <input id="gasoil-litros" type="number" inputmode="decimal" placeholder="50" oninput="updateGasoilPrecioPreview()" class="w-full bg-[#0E1526] border border-[#1C263E] rounded-lg px-2.5 py-2 text-sm text-white focus:border-[#00E676] outline-none">
              </div>
            </div>
            <div id="gasoil-precio-preview" class="hidden bg-[#00E676]/10 border border-[#00E676]/30 rounded-lg px-3 py-2 text-[11px] font-bold text-[#00E676] flex items-center justify-between">
              <span>💰 Precio/litro:</span>
              <span id="gasoil-precio-valor" class="font-mono text-sm">0.00 €/L</span>
            </div>
            <div>
              <label class="text-[10px] text-slate-400 font-bold uppercase">Estación / Nota</label>
              <input id="gasoil-estacion" type="text" placeholder="Repsol Jaén, Cepsa..." class="w-full bg-[#0E1526] border border-[#1C263E] rounded-lg px-2.5 py-2 text-xs text-white focus:border-[#38BDF8] outline-none">
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="text-[10px] text-slate-400 font-bold uppercase">KM</label>
                <input id="gasoil-km" type="number" placeholder="125000" class="w-full bg-[#0E1526] border border-[#1C263E] rounded-lg px-2.5 py-2 text-xs text-white outline-none">
              </div>
              <div>
                <label class="text-[10px] text-slate-400 font-bold uppercase">Fecha</label>
                <input id="gasoil-fecha" type="date" class="w-full bg-[#0E1526] border border-[#1C263E] rounded-lg px-2.5 py-2 text-xs text-white outline-none">
              </div>
            </div>
            <button onclick="addGasoilEntry()" class="w-full py-2.5 bg-[#FF007F] hover:bg-[#E11D48] text-white font-black rounded-xl text-xs transition-colors">+ Añadir Repostaje</button>
          </div>

          <!-- Lista tipo Excel -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <h4 class="text-[11px] font-black text-slate-300 uppercase">📋 Registros</h4>
              <span id="gasoil-count" class="text-[10px] text-slate-500">0 repostajes</span>
            </div>
            <div id="gasoil-list" class="space-y-1.5 max-h-[200px] overflow-y-auto">
              <!-- Se rellena con JS -->
            </div>
          </div>

          <!-- Total -->
          <div class="bg-[#FF007F]/10 border border-[#FF007F]/30 rounded-xl p-3 flex items-center justify-between">
            <span class="text-xs font-bold text-slate-300">TOTAL ESTA RUTA</span>
            <span id="gasoil-total-ruta" class="text-sm font-black text-[#FF007F] font-mono">0 €</span>
          </div>
        </div>

        <div class="p-3 border-t border-[#1C263E] bg-[#090E1A]">
          <button onclick="closeGasoilModal()" class="w-full py-2.5 bg-[#1C263E] hover:bg-[#253354] text-white font-bold rounded-xl text-xs">Cerrar</button>
        </div>
      </div>
    </div>


    <!-- MODAL OBSERVACIÓN -->
  <div id="modal-obs" class="fixed inset-0 z-50 hidden bg-black/70 flex items-end sm:items-center justify-center p-3">
    <div class="bg-[#0E1526] border border-[#1C263E] rounded-2xl w-full max-w-md p-4 space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-black text-orange-300">Nueva observación</h3>
        <button onclick="closeObsModal()" class="text-slate-400 text-lg">✕</button>
      </div>
      <p class="text-[10px] text-slate-400">Plantillas rápidas:</p>
      <div class="flex flex-wrap gap-1.5">
        <button type="button" onclick="applyObsTemplate('avisar')" class="px-2.5 py-1.5 rounded-lg text-[10px] font-bold bg-[#1C263E] border border-orange-500/40 text-orange-200">Avisar antes</button>
        <button type="button" onclick="applyObsTemplate('otra')" class="px-2.5 py-1.5 rounded-lg text-[10px] font-bold bg-[#1C263E] border border-orange-500/40 text-orange-200">Otra persona</button>
        <button type="button" onclick="applyObsTemplate('sitio')" class="px-2.5 py-1.5 rounded-lg text-[10px] font-bold bg-[#1C263E] border border-orange-500/40 text-orange-200">Otro sitio</button>
        <button type="button" onclick="applyObsTemplate('libre')" class="px-2.5 py-1.5 rounded-lg text-[10px] font-bold bg-[#1C263E] border border-slate-600 text-slate-300">Texto libre</button>
      </div>
      <textarea id="obs-text" rows="4" placeholder="Escribe la observación..." class="w-full bg-[#090E1A] border border-[#1C263E] rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-orange-500"></textarea>
      <p id="obs-context-label" class="text-[10px] text-slate-500"></p>
      <button onclick="saveObservacion()" class="w-full py-2.5 rounded-xl bg-orange-500 text-slate-950 font-black text-xs">Guardar</button>
    </div>
  </div>

  <div id="pdf-render-sandbox"></div>

  

  <!-- PERITAJE INTEGRADO -->
  

  

    


<!-- FAB eliminado, ahora integrado en dock -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.4/dist/confetti.browser.min.js"></script>





  <script src="app.js" defer></script>
</body>
</html>