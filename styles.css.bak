/* Motos@Motos styles - PesoPro-inspired */


    :root {
      --neon-green: #00E676;
      --neon-green-glow: rgba(0, 230, 118, 0.25);
      --neon-pink: #FF007F;
      --neon-pink-glow: rgba(255, 0, 127, 0.25);
      --bg-dark: #070A12;
      --bg-card: #0E1526;
      --bg-card-inner: #090E1A;
      --border-subtle: #1C263E;
    }

    body {
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-dark);
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    #pdf-render-sandbox {
      position: absolute;
      top: -99999px;
      left: 0;
      width: 794px;
      min-width: 794px;
      max-width: 794px;
      background-color: #070A12;
      color: #F8FAFC;
      box-sizing: border-box;
    }

    .timeline-container { position: relative; padding-left: 0.15rem; }
    .timeline-item { position: relative; padding-left: 2.35rem; margin-bottom: 0.45rem; }
    .timeline-item::before {
      content: '';
      position: absolute;
      left: 0.92rem;
      top: 1.65rem;
      bottom: -0.55rem;
      width: 2px;
      background: #FF007F;
      opacity: 0.55;
      z-index: 1;
    }
    .timeline-item:last-child::before { display: none; }
    .timeline-node {
      position: absolute; left: 0.2rem; top: 0.7rem; z-index: 2;
      width: 1.65rem; height: 1.65rem;
      border-radius: 9999px;
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 900;
      border: 2px solid transparent;
      box-shadow: 0 0 10px rgba(255, 0, 127, 0.35);
    }
    .timeline-node.is-base {
      background: #38BDF8; color: #0B1220; border-color: #7DD3FC;
      box-shadow: 0 0 12px rgba(56, 189, 248, 0.45);
    }
    .timeline-node.is-stop {
      background: #FF007F; color: #fff; border-color: #FF4DA6;
    }
    .timeline-node.is-done {
      background: #00E676; color: #070A12; border-color: #5CFFA8;
      box-shadow: 0 0 12px rgba(0, 230, 118, 0.4);
    }
    .timeline-card {
      background: #0B1220;
      border: 1px solid #1C263E;
      border-radius: 1rem;
      transition: border-color .15s ease;
    }
    .timeline-card:active { border-color: #FF007F66; }

    .glow-green { box-shadow: 0 0 15px var(--neon-green-glow); }
    .glow-pink { box-shadow: 0 0 15px var(--neon-pink-glow); }

    @media (min-width: 768px) {
      body {
        background:
          radial-gradient(900px 400px at 15% -5%, rgba(0, 230, 118, 0.08), transparent 55%),
          radial-gradient(700px 350px at 95% 10%, rgba(255, 0, 127, 0.08), transparent 50%),
          #05080E;
      }
      .app-shell {
        max-width: 56rem !important;
        border-radius: 1.25rem;
        margin-top: 1rem;
        margin-bottom: 1rem;
        min-height: calc(100vh - 2rem) !important;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85);
      }
      .app-shell > header { border-radius: 1.25rem 1.25rem 0 0; }
      .app-shell > nav { border-radius: 0; }
    }
    @media (min-width: 1024px) { .app-shell { max-width: 72rem !important; } }
    @media (min-width: 1280px) { .app-shell { max-width: 80rem !important; } }
  
    .peritaje-stage{background:#050810;border:1px solid #1C263E;border-radius:20px;overflow:hidden;position:relative}
    .peritaje-img-wrap{position:relative;display:flex;justify-content:center;align-items:center;min-height:280px;max-height:58vh;overflow:auto;background:repeating-linear-gradient(45deg,#060911,#060911 10px,#090E1A 10px,#090E1A 20px)}
    .peritaje-img-wrap img{display:block;max-width:100%;max-height:58vh;object-fit:contain}
    .pbox{position:absolute;border:2px solid var(--neon-green);background:rgba(0,230,118,.15);box-shadow:0 0 0 1px rgba(0,0,0,.5);pointer-events:none}
    .pbox.grave{border-color:var(--neon-pink);background:rgba(255,0,127,.2)}
    .pbox.moderado{border-color:#F59E0B;background:rgba(245,158,11,.15)}
    .pbox.leve{border-color:var(--neon-green);background:rgba(0,230,118,.12)}
    .pbox.micro{border-color:#A78BFA;background:rgba(167,139,250,.12)}
    .pbadge{font-size:9px;font-weight:900;padding:2px 5px;border-radius:5px;background:#070A12;color:#fff;position:absolute;left:-2px;top:-21px;white-space:nowrap;border:1px solid #1C263E}
    .per-photo-card{border:1px solid #1C263E;background:#090E1A;border-radius:14px;overflow:hidden;cursor:pointer}
    .per-photo-card.active{border-color:var(--neon-pink);box-shadow:0 0 10px var(--neon-pink-glow)}
    .per-photo-thumb{width:100%;height:82px;object-fit:cover;display:block}
    .per-damage{background:#0E1526;border:1px solid #1C263E;border-radius:14px;padding:10px}
    .per-damage.grave{border-color:rgba(255,0,127,.6)}
    .per-damage.moderado{border-color:rgba(245,158,11,.6)}
    .per-damage.leve{border-color:rgba(0,230,118,.5)}
    .per-damage.micro{border-color:rgba(167,139,250,.5)}

    :root{--app-max:80rem;--side-nav:7.2rem}
    html,body{min-height:100%;width:100%;overflow-x:hidden}
    .app-shell{transition:max-width .2s ease,margin .2s ease}

    @media (min-width:768px) and (max-width:1199px){
      .app-shell{max-width:64rem!important;margin:0 auto!important;min-height:100vh!important;border-radius:0!important;box-shadow:none!important}
      .app-shell>header{padding:1rem 1.25rem!important}
      .app-shell main{padding:1.25rem 1.5rem 2rem!important}
      #tab-inicio>div:first-child{padding:1.5rem!important}
      #tab-inicio .grid.grid-cols-2.lg\:grid-cols-4{grid-template-columns:repeat(4,minmax(0,1fr))}
      #tab-rutas #routes-header-card{grid-column:1/-1}
      #tab-buscar>div,#tab-ajustes>div{max-width:60rem;margin-left:auto;margin-right:auto}
      .app-shell>nav{padding:.65rem 4rem!important}
      .app-shell>nav .nav-btn{min-width:4.5rem}
    }

    @media (min-width:1200px){
      body{align-items:center!important}
      .app-shell{max-width:80rem!important;min-height:calc(100vh - 2rem)!important;height:calc(100vh - 2rem);margin:1rem auto!important;border-radius:1.25rem!important;overflow:hidden;box-shadow:0 25px 60px rgba(0,0,0,.8)!important;display:grid!important;grid-template-columns:var(--side-nav) minmax(0,1fr);grid-template-rows:auto minmax(0,1fr)!important}
      .app-shell>header{grid-column:1/-1;grid-row:1;height:4.5rem;padding:.85rem 1.5rem!important;border-radius:0!important}
      .app-shell>main{grid-column:2;grid-row:2;min-width:0;overflow-y:auto;padding:1.5rem 2rem 2rem!important}
      .app-shell>nav{grid-column:1;grid-row:2;display:flex!important;flex-direction:column!important;justify-content:flex-start!important;gap:.55rem;padding:1rem .65rem!important;border-top:0!important;border-right:1px solid #1C263E!important;overflow:visible!important}
      .app-shell>nav button{width:100%!important;min-height:4rem!important;margin:0!important;border-radius:1rem!important}
      .app-shell>nav #nav-nueva{order:0;width:100%!important;min-height:4rem!important;margin:0!important;border-radius:1rem!important}
      .app-shell>nav #nav-inicio{order:1}.app-shell>nav #nav-rutas{order:2}.app-shell>nav #nav-buscar{order:3}.app-shell>nav #nav-peritaje{order:4}.app-shell>nav #nav-ajustes{order:5}
      .app-shell>nav #nav-nueva span:first-child{font-size:1.35rem}
      .app-shell>nav .nav-btn span:first-child{font-size:1.35rem}
      #tab-inicio{max-width:72rem;margin:auto}
      #tab-inicio>div:first-child{padding:1.75rem!important}
      #tab-rutas #routes-header-card{grid-column:1/-1}
      #tab-buscar>div,#tab-ajustes>div{max-width:72rem;margin-left:auto;margin-right:auto}
      #modal-stats>div{max-width:56rem!important}
    }

    @media (max-width:420px){
      .app-shell main{padding-left:.75rem!important;padding-right:.75rem!important}
      .app-shell>header{padding-left:.75rem!important;padding-right:.75rem!important}
      .app-shell>nav button{padding-left:.4rem!important;padding-right:.4rem!important}
      .app-shell>nav .nav-btn{min-width:0!important}
    }

    @media (pointer:coarse){
      button,input,select,textarea{min-height:42px}
      .per-photo-card button{min-height:0}
    }
  
/* ===== MOTOSPRO THEME SYSTEM v2 ===== */
:root {
  --theme-primary: #FF6A00;
  --theme-bg: #0A0A0B;
  --theme-card: #161616;
  --theme-card-inner: #0F0F0F;
  --theme-border: rgba(255,255,255,0.08);
  --theme-text: #ffffff;
  --theme-text-dim: #9ca3af;
}
[data-theme="orange"] {
  --theme-primary: #FF6A00;
  --theme-bg: #0A0A0B;
  --theme-card: #161616;
  --theme-card-inner: #0F0F0F;
  --theme-border: rgba(255,255,255,0.08);
  --theme-success: #22c55e;
  --theme-accent: #FF6A00;
}
[data-theme="neon"] {
  --theme-primary: #00E676;
  --theme-bg: #070A12;
  --theme-card: #0E1526;
  --theme-card-inner: #090E1A;
  --theme-border: #1C263E;
  --theme-success: #00E676;
  --theme-accent: #FF007F;
}
[data-theme="light"] {
  --theme-primary: #0A0A0B;
  --theme-bg: #F8FAFC;
  --theme-card: #FFFFFF;
  --theme-card-inner: #F1F5F9;
  --theme-border: #E2E8F0;
  --theme-text: #0f172a;
  --theme-text-dim: #64748b;
  --theme-success: #16a34a;
  --theme-accent: #FF6A00;
}
[data-theme="blue"] {
  --theme-primary: #1E40FF;
  --theme-bg: #080D1A;
  --theme-card: #0E1526;
  --theme-card-inner: #0A122A;
  --theme-border: rgba(30,64,255,0.25);
  --theme-success: #38BDF8;
  --theme-accent: #1E40FF;
}
[data-theme="military"] {
  --theme-primary: #8B9A6B;
  --theme-bg: #111410;
  --theme-card: #1A1F18;
  --theme-card-inner: #151A14;
  --theme-border: rgba(139,154,107,0.25);
  --theme-success: #8B9A6B;
  --theme-accent: #C4B08B;
}

body { background: var(--theme-bg) !important; transition: background 0.3s ease; }
.app-shell { background: var(--theme-bg) !important; }
.bg-\[\#0E1526\] { background: var(--theme-card) !important; border-color: var(--theme-border) !important; }
.bg-\[\#090E1A\] { background: var(--theme-card-inner) !important; }
.border-\[\#1C263E\] { border-color: var(--theme-border) !important; }
.text-white { color: var(--theme-text) !important; }
.text-slate-400, .text-slate-300 { color: var(--theme-text-dim) !important; }

/* Theme cards */
.theme-card { cursor:pointer; border-radius:20px; padding:14px; border:2px solid transparent; transition: all 0.2s; position:relative; overflow:hidden; }
.theme-card.active { border-color: var(--theme-primary); box-shadow: 0 0 20px rgba(0,0,0,0.2); }
.theme-card .check { position:absolute; top:10px; right:10px; width:22px; height:22px; border-radius:50%; background:var(--theme-primary); color:black; display:flex; align-items:center; justify-content:center; font-weight:900; font-size:12px; opacity:0; transform:scale(0.5); transition:all 0.2s; }
.theme-card.active .check { opacity:1; transform:scale(1); }

[data-theme="light"] .app-shell { box-shadow: 0 20px 60px rgba(0,0,0,0.08) !important; }
[data-theme="light"] header { background: rgba(255,255,255,0.85) !important; backdrop-filter: blur(20px); }
[data-theme="light"] nav { background: rgba(255,255,255,0.9) !important; }


/* FIX: Ensure stops visible */
#stops-list { display: block !important; min-height: 200px; }
.timeline-container { overflow: visible !important; }
.timeline-item { position: relative; display: block !important; }
.stop-card-wrapper { display: none !important; } /* disable broken wrapper */
.stop-card-bg { display: none !important; }

/* FAB stable */
.fab-pro { position: fixed; bottom: 88px; right: 20px; width: 64px; height: 64px; border-radius: 50%; background: #FF6A00; color: black; display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: 900; box-shadow: 0 12px 32px rgba(255,106,0,0.45); z-index: 60; cursor: pointer; animation: pulse-orange 2.5s infinite; }
@keyframes pulse-orange { 0% { box-shadow: 0 0 0 0 rgba(255,106,0,0.6), 0 12px 32px rgba(255,106,0,0.45); } 70% { box-shadow: 0 0 0 16px rgba(255,106,0,0), 0 12px 32px rgba(255,106,0,0.45); } 100% { box-shadow: 0 0 0 0 rgba(255,106,0,0), 0 12px 32px rgba(255,106,0,0.45); } }
.fab-pro:active { transform: scale(0.92); }
@media (min-width: 1024px) { .fab-pro { bottom: 32px; right: 32px; } }



/* ===== BLOCK ===== */


:root {
  --bg: #070A12;
  --card: #0E1526;
  --card-border: #1C263E;
  --accent: #FF6A00;
  --accent-glow: rgba(255,106,0,0.3);
  --text: #F8FAFC;
  --text-dim: #94A3B8;
  --green: #00E676;
  --pink: #FF007F;
}
.theme-ktm { --bg:#070A12; --card:#0E1526; --card-border:#1C263E; --accent:#FF6A00; --accent-glow:rgba(255,106,0,0.3); --text:#F8FAFC; }
.theme-neon { --bg:#050510; --card:#0F0F1E; --card-border:#1E1E3A; --accent:#00FFFF; --accent-glow:rgba(0,255,255,0.3); --text:#E0FFFF; }
.theme-paper { --bg:#F8F9FA; --card:#FFFFFF; --card-border:#E2E8F0; --accent:#FF6A00; --accent-glow:rgba(255,106,0,0.2); --text:#0F172A; --text-dim:#64748B; }
.theme-olive { --bg:#1A1F1A; --card:#242B24; --card-border:#3A4A3A; --accent:#8A9A5B; --accent-glow:rgba(138,154,91,0.3); --text:#E8E6D9; }
.theme-glass { --bg:#000000; --card:rgba(255,255,255,0.06); --card-border:rgba(255,255,255,0.12); --accent:#FF6A00; --accent-glow:rgba(255,106,0,0.4); --text:#FFFFFF; }
.theme-midnight { --bg:#0B0E1A; --card:#111827; --card-border:#1F2937; --accent:#38BDF8; --accent-glow:rgba(56,189,248,0.3); --text:#F1F5F9; }

/* Top Tabs for expediente */
/* Expediente submenu — C: solo iconos (móvil) + D: lateral (desktop) */
.exp-tabs-wrap {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin: 8px 0 12px;
}
.exp-tabs-bar {
  display: flex;
  flex-direction: row;
  gap: 6px;
  background: var(--card-inner, #0F172A);
  border: 1px solid var(--card-border, #1E293B);
  border-radius: 16px;
  padding: 6px;
  margin: 0;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.exp-tabs-bar::-webkit-scrollbar { display: none; }

/* C — solo iconos */
.exp-tab-btn {
  flex: 1;
  min-width: 52px;
  padding: 12px 8px;
  border-radius: 12px;
  font-size: 0;
  font-weight: 700;
  text-align: center;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, transform 0.1s ease;
  color: var(--text-dim, #94A3B8);
  border: none;
  min-height: 48px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  background: transparent !important;
  box-shadow: none !important;
  position: relative;
}
.exp-tab-btn > span:first-child {
  font-size: 22px;
  line-height: 1;
  opacity: 0.75;
}
/* ocultar texto en móvil (solo icono) */
.exp-tab-btn > span:last-child {
  display: none;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.02em;
}
.exp-tab-btn.active {
  color: var(--accent, #14B8A6) !important;
  background: color-mix(in srgb, var(--accent, #14B8A6) 16%, transparent) !important;
}
.exp-tab-btn.active > span:first-child { opacity: 1; }
.exp-tab-btn:active { transform: scale(0.96); }

/* tooltip label under icon on active only - optional tiny dot */
.exp-tab-btn.active::after {
  content: "";
  position: absolute;
  bottom: 5px;
  left: 50%;
  transform: translateX(-50%);
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--accent, #14B8A6);
}

.exp-tab-content { display: none; }
.exp-tab-content.active { display: block; animation: fadeIn 0.18s ease; }
@keyframes fadeIn { from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:translateY(0);} }

/* D — menú lateral en escritorio */
@media (min-width: 900px) {
  .exp-tabs-wrap {
    flex-direction: row;
    align-items: flex-start;
    gap: 14px;
  }
  .exp-tabs-bar {
    flex-direction: column;
    width: 148px;
    flex-shrink: 0;
    position: sticky;
    top: 12px;
    padding: 8px;
    gap: 4px;
    overflow-x: visible;
  }
  .exp-tab-btn {
    flex: none;
    width: 100%;
    min-width: 0;
    flex-direction: row;
    justify-content: flex-start;
    gap: 10px;
    padding: 12px 12px;
    font-size: 12px;
    border-radius: 12px;
  }
  .exp-tab-btn > span:first-child {
    font-size: 18px;
    width: 24px;
    text-align: center;
  }
  .exp-tab-btn > span:last-child {
    display: inline !important;
    font-size: 12px;
  }
  .exp-tab-btn.active::after { display: none; }
  .exp-tabs-wrap > .exp-tab-content.active {
    flex: 1;
    min-width: 0;
    display: block;
  }
}


/* Action row big */
.action-row-4 { display:grid; grid-template-columns:repeat(4, 1fr); gap:8px; margin:10px 0; }
.action-btn-big { min-height:52px; border-radius:12px; font-size:11px; font-weight:800; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; border:1px solid var(--card-border); background:var(--card); color:var(--text); cursor:pointer; transition:all 0.2s; }
.action-btn-big.primary { background:var(--accent); color:#000; border-color:var(--accent); box-shadow:0 4px 12px var(--accent-glow); }
.action-btn-big:active { transform:scale(0.96); }


/* ===== BLOCK ===== */


/* ========== PesoPro visual language applied to Motos@Motos ========== */
:root {
  --neon-green: #14B8A6 !important;
  --neon-green-glow: rgba(20, 184, 166, 0.28) !important;
  --neon-pink: #2DD4BF !important;
  --neon-pink-glow: rgba(45, 212, 191, 0.22) !important;
  --bg-dark: #0B1120 !important;
  --bg-card: #161F2E !important;
  --bg-card-inner: #0F172A !important;
  --border-subtle: #1E293B !important;
  --theme-primary: #14B8A6 !important;
  --theme-bg: #0B1120 !important;
  --theme-card: #161F2E !important;
  --theme-card-inner: #0F172A !important;
  --theme-border: #1E293B !important;
  --theme-text: #E2E8F0 !important;
  --theme-text-dim: #94A3B8 !important;
  --theme-success: #14B8A6 !important;
  --theme-accent: #14B8A6 !important;
  --bg: #0B1120 !important;
  --card: #161F2E !important;
  --card-border: #1E293B !important;
  --accent: #14B8A6 !important;
  --accent-glow: rgba(20, 184, 166, 0.3) !important;
  --text: #E2E8F0 !important;
  --text-dim: #94A3B8 !important;
  --green: #14B8A6 !important;
  --pink: #38BDF8 !important;
}

html, body {
  background: var(--theme-bg, #0B1120) !important;
  color: var(--theme-text, #E2E8F0) !important;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
}

.app-shell {
  background: var(--theme-bg, #0B1120) !important;
  border-color: var(--theme-border, #1E293B) !important;
  color: var(--theme-text, #E2E8F0) !important;
}

.app-shell > header {
  background: rgba(11, 17, 32, 0.92) !important;
  border-bottom: 1px solid #1E293B !important;
  backdrop-filter: blur(16px);
}

/* Map Motos hardcoded colors → PesoPro */
.bg-\[\#070A12\],
.bg-\[\#05080E\],
.bg-\[\#0A0A0B\] { background-color: #0B1120 !important; }
.bg-\[\#0E1526\],
.bg-\[\#0B1220\] { background-color: #161F2E !important; }
.bg-\[\#090E1A\],
.bg-\[\#060911\] { background-color: #0F172A !important; }
.border-\[\#1C263E\] { border-color: #1E293B !important; }

/* Accent: orange/pink/neon green → teal */
.bg-\[\#FF6A00\],
.bg-\[\#FF007F\],
.bg-\[\#00E676\] { background-color: #14B8A6 !important; color: #042F2E !important; }
.text-\[\#FF6A00\],
.text-\[\#FF007F\],
.text-\[\#00E676\] { color: #14B8A6 !important; }
.border-\[\#FF6A00\],
.border-\[\#FF007F\],
.border-\[\#00E676\] { border-color: #14B8A6 !important; }

/* Cards like PesoPro */
.app-shell main .bg-\[\#0E1526\],
.app-shell main .rounded-2xl,
.app-shell main .rounded-3xl,
.app-shell main [class*="rounded-\["] {
  border-radius: 20px !important;
}

/* Bottom / top nav → dock style like PesoPro */
.top-nav-pro,
.app-shell > nav {
  background: transparent !important;
  border: none !important;
  padding: 0.5rem 0.75rem max(0.75rem, env(safe-area-inset-bottom)) !important;
}
.top-nav-pro {
  display: flex !important;
  gap: 4px !important;
  max-width: 100%;
  margin: 0 auto;
  background: #0f172a !important;
  border: 1px solid rgba(148, 163, 184, 0.2) !important;
  border-radius: 18px !important;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45) !important;
  padding: 4px !important;
}
.nav-pill {
  flex: 1 !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 2px !important;
  min-height: 52px !important;
  border-radius: 14px !important;
  border: none !important;
  background: transparent !important;
  color: #64748b !important;
  font-weight: 700 !important;
  position: relative !important;
  transition: color .15s ease, background .15s ease !important;
}
.nav-pill.active {
  background: rgba(20, 184, 166, 0.14) !important;
  color: #5eead4 !important;
  box-shadow: none !important;
}
.nav-pill.active::before {
  content: "";
  position: absolute;
  top: 6px;
  left: 50%;
  transform: translateX(-50%);
  width: 16px;
  height: 3px;
  border-radius: 99px;
  background: #14B8A6;
}

/* FAB → teal */
.fab-pro {
  background: linear-gradient(135deg, #14B8A6, #0D9488) !important;
  color: #042F2E !important;
  box-shadow: 0 12px 32px rgba(20, 184, 166, 0.4) !important;
  animation: none !important;
}
@keyframes pulse-orange {
  0%, 100% { box-shadow: 0 12px 32px rgba(20, 184, 166, 0.4); }
}

/* Buttons primary */
button.bg-orange-500,
button[class*="bg-\[\#FF"],
.action-btn-big.primary {
  background: linear-gradient(135deg, #14B8A6 0%, #0D9488 100%) !important;
  color: #042F2E !important;
  border-color: #14B8A6 !important;
  box-shadow: 0 4px 14px rgba(20, 184, 166, 0.35) !important;
}

/* Timeline → teal instead of pink */
.timeline-item::before { background: #14B8A6 !important; opacity: 0.5 !important; }
.timeline-node.is-stop {
  background: #14B8A6 !important;
  color: #042F2E !important;
  border-color: #5eead4 !important;
  box-shadow: 0 0 12px rgba(20, 184, 166, 0.4) !important;
}
.timeline-node.is-done {
  background: #14B8A6 !important;
  color: #042F2E !important;
  border-color: #5eead4 !important;
}
.timeline-node.is-base {
  background: #38BDF8 !important;
  color: #0B1120 !important;
  border-color: #7DD3FC !important;
}
.timeline-card {
  background: #161F2E !important;
  border-color: #1E293B !important;
  border-radius: 1rem !important;
}
.timeline-card:active { border-color: rgba(20, 184, 166, 0.5) !important; }

/* Peritaje boxes */
.pbox { border-color: #14B8A6 !important; background: rgba(20, 184, 166, 0.12) !important; }
.pbox.grave { border-color: #F87171 !important; background: rgba(248, 113, 113, 0.15) !important; }
.pbox.moderado { border-color: #F59E0B !important; background: rgba(245, 158, 11, 0.12) !important; }
.pbox.leve { border-color: #14B8A6 !important; background: rgba(20, 184, 166, 0.12) !important; }
.per-photo-card.active {
  border-color: #14B8A6 !important;
  box-shadow: 0 0 10px rgba(20, 184, 166, 0.25) !important;
}
.per-damage.grave { border-color: rgba(248, 113, 113, 0.6) !important; }
.per-damage.leve { border-color: rgba(20, 184, 166, 0.5) !important; }

/* Meta theme color */
meta[name="theme-color"] { /* handled by JS override below */ }

/* Soften glow utilities */
.glow-green { box-shadow: 0 0 15px rgba(20, 184, 166, 0.28) !important; }
.glow-pink { box-shadow: 0 0 15px rgba(56, 189, 248, 0.25) !important; }

/* Inputs */
input, select, textarea {
  background: #0F172A !important;
  border-color: #1E293B !important;
  color: #E2E8F0 !important;
  border-radius: 12px !important;
}

/* Toast / badges feel */
[class*="text-\[\#00E676\]"] { color: #14B8A6 !important; }

/* Desktop shell */
@media (min-width: 768px) {
  body {
    background:
      radial-gradient(900px 400px at 15% -5%, rgba(20, 184, 166, 0.08), transparent 55%),
      radial-gradient(700px 350px at 95% 10%, rgba(56, 189, 248, 0.06), transparent 50%),
      #0B1120 !important;
  }
  .app-shell {
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85) !important;
    border-radius: 1.25rem !important;
  }
}

/* Critical fallbacks when Tailwind CDN fails (WPS / offline) */
.hidden,
input[type="file"].hidden,
input.hidden,
input[type="file"][class*="hidden"] {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  position: absolute !important;
  opacity: 0 !important;
  pointer-events: none !important;
  overflow: hidden !important;
}
#toast {
  opacity: 0 !important;
  pointer-events: none !important;
  visibility: hidden !important;
  transform: translate(-50%, 0) !important;
  background: linear-gradient(135deg, #14B8A6, #0D9488) !important;
  color: #042F2E !important;
  box-shadow: 0 8px 24px rgba(20,184,166,.35) !important;
}
#toast.show,
#toast.opacity-100,
#toast[data-visible="1"] {
  opacity: 1 !important;
  visibility: visible !important;
  pointer-events: auto !important;
}
.opacity-0 { opacity: 0 !important; }
.pointer-events-none { pointer-events: none !important; }
.fixed { position: fixed !important; }
.sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0,0,0,0) !important;
  border: 0 !important;
}

/* Header polish */
.app-shell > header {
  display: flex !important;
  align-items: center !important;
  gap: 0.75rem !important;
}
.app-shell > header h1,
.app-shell > header .text-xl {
  color: #5eead4 !important;
  font-weight: 800 !important;
  letter-spacing: -0.02em !important;
}

/* Home hero card */
#tab-inicio > div:first-child,
#tab-inicio .rounded-3xl,
#tab-inicio .rounded-2xl {
  background: #161F2E !important;
  border: 1px solid #1E293B !important;
  border-radius: 22px !important;
  box-shadow: 0 8px 32px rgba(0,0,0,.25) !important;
}

/* Nav dock already styled — ensure it sits clean under header */
.top-nav-pro {
  margin: 0.5rem 0.75rem 0.75rem !important;
}


/* ===== BLOCK ===== */


      .top-nav-pro { position: sticky; top: 0; z-index: 40; background: rgba(10,10,11,0.88); backdrop-filter: blur(20px) saturate(1.5); border-bottom: 1px solid var(--theme-border); }
      .nav-pill { position: relative; display:flex; flex-direction:column; align-items:center; gap:2px; padding:8px 14px; border-radius:14px; transition: all 0.2s cubic-bezier(0.16,1,0.3,1); color: var(--theme-text-dim); }
      .nav-pill.active { background: var(--theme-primary); color: black !important; box-shadow: 0 6px 20px rgba(0,0,0,0.25); transform: translateY(-1px); }
      .nav-pill.active .nav-icon { transform: scale(1.1); }
      .nav-pill .nav-badge { position:absolute; top:4px; right:8px; width:7px; height:7px; border-radius:50%; background:#22c55e; box-shadow:0 0 8px #22c55e; display:none; }
      .nav-pill.has-alert .nav-badge { display:block; }
      @media (min-width: 1024px) {
        .top-nav-pro { display:none !important; }
        .desktop-sidebar { display:flex !important; }
        .app-shell { margin-left: 88px !important; }
      }
      @media (max-width: 1023px) {
        .desktop-sidebar { display:none !important; }
      }
      .desktop-sidebar { position:fixed; left:0; top:0; bottom:0; width:88px; background: var(--theme-card); border-right:1px solid var(--theme-border); z-index:50; flex-direction:column; align-items:center; padding:20px 0; gap:8px; }
      .desktop-sidebar .side-btn { width:56px; height:56px; border-radius:16px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; color:var(--theme-text-dim); transition:all 0.2s; cursor:pointer; border:1px solid transparent; }
      .desktop-sidebar .side-btn:hover { background: var(--theme-card-inner); color: var(--theme-text); border-color: var(--theme-border); }
      .desktop-sidebar .side-btn.active { background: var(--theme-primary); color:black; box-shadow:0 8px 24px rgba(0,0,0,0.3); }
      .desktop-sidebar .side-btn span:last-child { font-size:8px; font-weight:900; letter-spacing:0.05em; }
    
/* FIX: Ensure stops visible */
#stops-list { display: block !important; min-height: 200px; }
.timeline-container { overflow: visible !important; }
.timeline-item { position: relative; display: block !important; }
.stop-card-wrapper { display: none !important; } /* disable broken wrapper */
.stop-card-bg { display: none !important; }

/* FAB stable */
.fab-pro { position: fixed; bottom: 88px; right: 20px; width: 64px; height: 64px; border-radius: 50%; background: #FF6A00; color: black; display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: 900; box-shadow: 0 12px 32px rgba(255,106,0,0.45); z-index: 60; cursor: pointer; animation: pulse-orange 2.5s infinite; }
@keyframes pulse-orange { 0% { box-shadow: 0 0 0 0 rgba(255,106,0,0.6), 0 12px 32px rgba(255,106,0,0.45); } 70% { box-shadow: 0 0 0 16px rgba(255,106,0,0), 0 12px 32px rgba(255,106,0,0.45); } 100% { box-shadow: 0 0 0 0 rgba(255,106,0,0), 0 12px 32px rgba(255,106,0,0.45); } }
.fab-pro:active { transform: scale(0.92); }
@media (min-width: 1024px) { .fab-pro { bottom: 32px; right: 32px; } }



/* ===== Unified theme switcher (works on click) ===== */
html[data-theme="orange"], html[data-theme="ktm"] {
  --theme-primary: #FF6A00;
  --theme-bg: #0A0A0B;
  --theme-card: #161616;
  --theme-card-inner: #0F0F0F;
  --theme-border: rgba(255,255,255,0.08);
  --theme-text: #ffffff;
  --theme-text-dim: #9ca3af;
  --accent: #FF6A00;
  --bg: #0A0A0B;
  --card: #161616;
  --card-border: rgba(255,255,255,0.08);
  --text: #ffffff;
  --text-dim: #9ca3af;
  --neon-green: #FF6A00;
  --neon-pink: #FF8A33;
  --bg-dark: #0A0A0B;
  --bg-card: #161616;
  --bg-card-inner: #0F0F0F;
  --border-subtle: rgba(255,255,255,0.08);
}
